// CHANGELOG 2026-06-12 (Ice Lattice WASM upgrade)
// - Added MILKDROP_PRESET_VERSION=200 + PSVERSION_WARP/COMP=3 for GLES3 HLSL-9
// - Aspect-corrected hex ice-lattice warp; rainbow-ice composite with bass brighten
// - Wave samples=128; centered hex shape with bass-reactive radius + slow spin
// Target: PSVERSION_WARP=3 PSVERSION_COMP=3 | Brief: docs/milk014_creative_brief.md
[preset00]
presetname=Ice Lattice
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
fRating=3.000000
fGammaAdj=1.100000
fDecay=0.960000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.800000
fWaveScale=1.000000
fWaveSmoothing=0.500000
fWaveParam=0.000000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=0.000000
zoom=1.000000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.010000
sx=1.000000
sy=1.000000
wave_r=0.200000
wave_g=0.700000
wave_b=1.000000
wave_x=0.500000
wave_y=0.500000
ob_size=0.000000
ob_r=0.000000
ob_g=0.000000
ob_b=0.000000
ob_a=0.000000
ib_size=0.000000
ib_r=0.250000
ib_g=0.250000
ib_b=0.250000
ib_a=0.000000
wavecode_0_enabled=1
wavecode_0_mode=0
wavecode_0_bspectrum=0
wavecode_0_busedots=0
wavecode_0_bdrawthick=0
wavecode_0_badditive=1
wavecode_0_samples=128
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.500000
wavecode_0_r=0.200000
wavecode_0_g=0.800000
wavecode_0_b=1.000000
wavecode_0_a=0.800000
shapecode_0_enabled=1
shapecode_0_sides=6
shapecode_0_additive=0
shapecode_0_thickoutline=0
shapecode_0_textured=0
shapecode_0_num_inst=1
shapecode_0_x=0.500000
shapecode_0_y=0.500000
shapecode_0_rad=0.080000
shapecode_0_ang=0.000000
shapecode_0_r=0.300000
shapecode_0_g=0.600000
shapecode_0_b=0.900000
shapecode_0_a=0.500000
shapecode_0_r2=0.100000
shapecode_0_g2=0.300000
shapecode_0_b2=0.600000
shapecode_0_a2=0.200000
shapecode_0_border_r=0.400000
shapecode_0_border_g=0.700000
shapecode_0_border_b=1.000000
shapecode_0_border_a=0.400000
shapecode_0_per_frame1=rad=0.08+q2*0.04
shapecode_0_per_frame2=ang=q1*0.2
per_frame_1=q1=time
per_frame_2=q2=bass_att
per_frame_3=q3=mid_att
per_frame_4=q4=treb_att
per_frame_5=q5=sin(time*0.3)
per_frame_6=q6=cos(time*0.3)
per_frame_7=q7=0.5+0.5*sin(time*0.7)
per_frame_8=q8=0.5+0.5*cos(time*0.5)
per_frame_9=q9=q2*0.03
per_frame_10=q10=q3*0.04
per_frame_11=q11=1.0+q2*0.15
per_frame_12=q12=time*0.2+q3*0.8
per_frame_13=wave_r=0.2+0.2*q2
per_frame_14=wave_g=0.5+0.3*q3
per_frame_15=wave_b=0.8+0.2*q4
per_pixel_1=zoom=1.0
per_pixel_2=rot=0.0
per_pixel_3=warp=0.01
warp_1=`shader_body
warp_2=`{
warp_3=`float2 p = (uv - 0.5) * aspect.xy;
warp_4=`float rot = q12;
warp_5=`float cr = cos(rot); float sr = sin(rot);
warp_6=`float2 pr = float2(p.x * cr - p.y * sr, p.x * sr + p.y * cr);
warp_7=`float sc = 8.0 + q2 * 4.0;
warp_8=`float d1 = dot(pr, float2(1.0, 0.0)) * sc;
warp_9=`float d2 = dot(pr, float2(0.5, 0.8660254)) * sc;
warp_10=`float d3 = dot(pr, float2(-0.5, 0.8660254)) * sc;
warp_11=`float f1 = abs(d1 - floor(d1 + 0.5));
warp_12=`float f2 = abs(d2 - floor(d2 + 0.5));
warp_13=`float f3 = abs(d3 - floor(d3 + 0.5));
warp_14=`float dist = min(f1, min(f2, f3));
warp_15=`float lattice = smoothstep(0.12, 0.0, dist);
warp_16=`float pulse = 1.0 + q9 * sin(dist * 20.0 - q1 * 3.0);
warp_17=`float2 offset = float2(cos(d1 * 0.5), sin(d2 * 0.5)) * q10 * 0.02;
warp_18=`float2 refract = pr * pulse + offset + lattice * q2 * 0.03;
warp_19=`ret = tex2D(sampler_main, refract * aspect.zw + 0.5).xyz;
warp_20=`}
comp_1=`shader_body
comp_2=`{
comp_3=`float3 col = tex2D(sampler_main, uv).xyz;
comp_4=`float2 d = uv - 0.5;
comp_5=`float r = length(d);
comp_6=`float vig = smoothstep(0.7, 0.2, r);
comp_7=`float3 ice = float3(0.3, 0.6, 1.0);
comp_8=`col = lerp(col, col * ice * 1.3, 0.4);
comp_9=`float3 rainbow;
comp_10=`rainbow.r = sin(q1 * 0.7) * 0.5 + 0.5;
comp_11=`rainbow.g = sin(q1 * 0.7 + 2.094) * 0.5 + 0.5;
comp_12=`rainbow.b = sin(q1 * 0.7 + 4.189) * 0.5 + 0.5;
comp_13=`col += rainbow * (1.0 - vig) * 0.15 * q4;
comp_14=`col *= 0.9 + 0.1 * q2;
comp_15=`ret = saturate(col);
comp_16=`}
