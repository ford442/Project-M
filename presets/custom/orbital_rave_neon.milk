// Signature Series | orbital_rave | Zephyr Orbital
// tags: rave, neon, synthwave, medium
// author: projectM-signature-batch-2026-07
// project: zephyr-orbital
// music: synthwave, electro house
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Orbital Rave Neon
fRating=4.500000
fGammaAdj=1.750000
fDecay=0.965000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nWaveMode=0
bAdditiveWaves=0
fWaveAlpha=0.001000
fWarpScale=1.331000
zoom=1.000000
rot=0.000000
warp=0.010000
cx=0.500000
cy=0.500000
mv_a=0.000000

per_frame_1=q1=time*1.2
per_frame_2=q2=bass
per_frame_3=q3=mid_att
per_frame_4=q4=treb_att
per_frame_5=q5=0.5+0.5*sin(time*1.1)
per_frame_6=q6=8.0
per_frame_7=q7=0.15+q2*0.1
per_frame_8=q8=mid_att
per_frame_9=q9=sin(time*2.0)
per_frame_10=q10=0.14
per_frame_11=q11=1.0+q2*0.3
per_frame_12=q12=time

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`float2 uvc=uv-0.5;
warp_4=`float r=length(uvc);
warp_5=`float a=atan2(uvc.y,uvc.x)+q1*q7*2.0;
warp_6=`float2 ring1=float2(cos(a*2.0),sin(a*2.0))*r*0.9;
warp_7=`float2 ring2=float2(cos(a*3.0+q5),sin(a*3.0+q5))*r*0.7;
warp_8=`float2 uv1=ring1+0.5;
warp_9=`float2 uv2=ring2+0.5;
warp_10=`float3 c1=tex2D(sampler_main,uv1).xyz;
warp_11=`float3 c2=tex2D(sampler_main,uv2).xyz;
warp_12=`float3 tint=float3(0.1+q8*0.3,0.4+q3*0.6,1.0);
warp_13=`ret=(c1+c2*0.8)*tint;
warp_14=`}

comp_1=`shader_body
comp_2=`{
comp_3=`float3 col=tex2D(sampler_main,uv).xyz;
comp_4=`float beat=0.5+0.5*sin(q12*8.0+q2*6.0);
comp_5=`col*=float3(0.8+beat*0.2,0.7,1.0+beat*0.3);
comp_6=`ret=saturate(col*q11);
comp_7=`}
