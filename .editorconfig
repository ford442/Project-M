# Editor defaults matching what the repo already does. C/C++ layout is owned
# by .clang-format, JS layout by .prettierrc.json; this only covers what an
# editor does before either formatter runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# Deployed as-is: vendored and generated.
[{vendor/**,html/flac-player/bundle.*.js,html/flac-player/vendor/**,html/flac-decode/example/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
