// CHANGELOG 2026-06-19 — WASM upgrade
// - Ported sparkle plasma from per_pixel HLSL → comp_ shader
// - Added MILKDROP_PRESET_VERSION=200 + PSVERSION_WARP/COMP=3
// Author: projectM AI | Sparkle Plasma
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Sparkle Plasma
fRating=3.0
fGammaAdj=1.0
fDecay=0.980
fVideoEchoZoom=1.0
fVideoEchoAlpha=0.0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.001
fWaveScale=1.002
fWaveSmoothing=0.261
fWaveParam=0.0
fModWaveAlphaStart=0.5
fModWaveAlphaEnd=1.0
fWarpAnimSpeed=1.0
fWarpScale=1.331
fZoomExponent=1.0
fShader=0.0
zoom=1.005
rot=0.0
cx=0.5
cy=0.5
dx=0.0
dy=0.0
warp=0.01
sx=1.0
sy=1.0
ob_size=0.01
ib_size=0.01
mv_a=0.0

per_frame_1=rot=rot+0.002;
per_frame_2=q1=1+30*(0.5+0.5*sin(time*0.15));
per_frame_3=q2=0.5+0.5*sin(time*0.4);
per_frame_4=cx=0.5+0.05*bass_att*sin(time*0.3);
per_frame_5=cy=0.5+0.05*treb_att*cos(time*0.33);
per_frame_6=q3=time*0.2;
per_frame_7=q4=time*0.33;
per_frame_8=q5=time;
per_frame_9=q6=time*0.8;
per_frame_10=q7=time*0.5;
per_frame_11=q8=time*0.6;
per_frame_12=q9=time*2.0;
per_frame_13=q10=bass_att;
per_frame_14=q11=treb_att;

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz;
warp_4=`}

comp_1=`shader_body
comp_2=`{
comp_3=`    float segX = floor(uv.x * q1) / q1;
comp_4=`    float segY = floor(uv.y * q1) / q1;
comp_5=`    float workX = lerp(uv.x, segX, q2);
comp_6=`    float workY = lerp(uv.y, segY, q2);
comp_7=`    float dist = sqrt(pow(workX - 0.5, 2.0) + pow(workY - 0.5, 2.0)) * 2.0;
comp_8=`    float v1 = sin(workX * 10.0 + q5);
comp_9=`    float v2 = sin((workX * sin(q3) + workY * cos(q4)) * 10.0 + q5);
comp_10=`    float v3 = sin(sqrt(100.0 * (pow(workX - 0.5, 2.0) + pow(workY - 0.5, 2.0))) + q5);
comp_11=`    float c = v1 + v2 + v3;
comp_12=`    float brightness = 0.4 + 0.6 * q10;
comp_13=`    float r = min(brightness * (0.5 + 0.5 * sin(c * 3.1415 + q6)), 1.0);
comp_14=`    float g = min(brightness * (0.5 + 0.5 * sin(c * 3.1415 + q7 + 2.0)), 1.0);
comp_15=`    float b = min(brightness * (0.5 + 0.5 * sin(dist - 0.5 + c * 3.1415 + q8 + 4.0)), 1.0);
comp_16=`  float sparkle = (1.0 - dist) * step(0.99, sin((atan2(workY, workX) + q9) * 10.0)) * q11;
comp_17=`    ret = saturate(float3(min(r + sparkle, 1.0), min(g + sparkle, 1.0), min(b + sparkle, 1.0)));
comp_18=`}
