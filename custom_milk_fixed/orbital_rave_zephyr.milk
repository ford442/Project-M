// Signature Series | orbital_rave | Zephyr Orbital
// tags: rave, orbital, bass-reactive, medium
// author: projectM-signature-batch-2026-07
// project: zephyr-orbital
// music: uptempo electronic, drum & bass
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Orbital Rave Zephyr
fRating=4.500000
fGammaAdj=1.700000
fDecay=0.968000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
fWaveAlpha=0.001000
fWaveScale=1.000000
fWarpAnimSpeed=1.000000
fWarpScale=1.331000
fZoomExponent=1.000000
fShader=0.000000
zoom=1.000000
rot=0.000000
cx=0.500000
cy=0.500000
warp=0.010000
sx=1.000000
sy=1.000000
ob_size=0.005000
ib_size=0.010000
mv_a=0.000000

per_frame_1=q1=time
per_frame_2=q2=bass_att
per_frame_3=q3=mid_att
per_frame_4=q4=treb_att
per_frame_5=q5=0.5+0.5*sin(time*0.4)
per_frame_6=q6=6.0+q2*4.0
per_frame_7=q7=0.12+q2*0.08
per_frame_8=q8=mid_att
per_frame_9=q9=0.5+0.5*sin(time*0.9)
per_frame_10=q10=0.18+q4*0.12
per_frame_11=q11=1.0+q2*0.25
per_frame_12=q12=time*0.6

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`float2 uvc=uv-0.5;
warp_4=`float r=length(uvc);
warp_5=`float a=atan2(uvc.y,uvc.x)+q1*q7;
warp_6=`float seg=6.2831853/q6;
warp_7=`a=a-floor(a/seg)*seg;
warp_8=`float tunnelR=pow(r,0.55+q2*0.35);
warp_9=`float2 baseUV=float2(cos(a)*tunnelR,sin(a)*tunnelR)+0.5;
warp_10=`float3 col=tex2D(sampler_main,baseUV).xyz;
warp_11=`float2 o1=baseUV+float2(q10*cos(q1*2.0),q10*sin(q1*2.0));
warp_12=`col+=tex2D(sampler_main,o1).xyz*0.7;
warp_13=`float3 tint=float3(0.2+q8*0.8,0.1+q3*0.5,0.7+q2*0.5);
warp_14=`ret=col*tint*q11;
warp_15=`}

comp_1=`shader_body
comp_2=`{
comp_3=`float3 col=tex2D(sampler_main,uv).xyz;
comp_4=`float2 c=uv-0.5;
comp_5=`float d=length(c);
comp_6=`float glow=pow(1.0-smoothstep(0.0,0.5,d),2.0);
comp_7=`col+=float3(0.3+q2,0.1,0.6+q4)*glow*0.2;
comp_8=`col*=1.0-smoothstep(0.35,0.9,d);
comp_9=`ret=saturate(col*q11);
comp_10=`}
