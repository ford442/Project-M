// Signature Series | cinematic_pedal_steel | Watershed
// tags: cinematic, warm, ambient, light
// author: projectM-signature-batch-2026-07
// project: watershed
// music: pedal steel, ambient country, slow ballads
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Cinematic Pedal Steel Watershed
fRating=4.000000
fGammaAdj=1.350000
fDecay=0.978000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nWaveMode=0
bAdditiveWaves=0
fWaveAlpha=0.001000
fWarpScale=1.200000
zoom=1.000000
rot=0.000000
warp=0.008000
cx=0.500000
cy=0.500000
mv_a=0.000000

per_frame_1=q1=time*0.15
per_frame_2=q2=bass_att
per_frame_3=q3=mid_att
per_frame_4=q4=treb_att
per_frame_5=q5=0.5+0.5*sin(time*0.2)
per_frame_6=q6=1.0
per_frame_7=q7=0.04
per_frame_8=q8=mid_att
per_frame_9=q9=time*0.05
per_frame_10=q10=0.06
per_frame_11=q11=0.95+q3*0.1
per_frame_12=q12=time

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.008;

warp_1=`shader_body
warp_2=`{
warp_3=`float2 uvc=uv-0.5;
warp_4=`uvc.x+=q9*0.02;
warp_5=`float r=length(uvc);
warp_6=`float a=atan2(uvc.y,uvc.x)+q7*sin(q1);
warp_7=`float2 nuv=float2(cos(a)*r,sin(a)*r)*(1.0+q2*0.03)+0.5;
warp_8=`float3 col=tex2D(sampler_main,nuv).xyz;
warp_9=`ret=lerp(col,float3(0.9,0.7,0.45),q3*0.08);
warp_10=`}

comp_1=`shader_body
comp_2=`{
comp_3=`float3 col=tex2D(sampler_main,uv).xyz;
comp_4=`float2 c=uv-0.5;
comp_5=`float d=length(c);
comp_6=`float vig=1.0-smoothstep(0.25,0.85,d);
comp_7=`col*=float3(1.05+q3*0.15,0.95+q2*0.05,0.75);
comp_8=`col*=vig;
comp_9=`col=pow(col,float3(0.95,0.98,1.05));
comp_10=`ret=saturate(col*q11);
comp_11=`}
