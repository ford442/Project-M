// CHANGELOG 2026-06-19 — WASM upgrade
// - Moved granite texture from per_pixel HLSL → comp_ shader
// - Added shader_body wrappers and preset headers
// Author: projectM AI | Fractal Echo Granite
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Fractal Echo Granite
fRating=4.0
fGammaAdj=1.5
fDecay=0.970
fVideoEchoZoom=1.0
fVideoEchoAlpha=0.0
nWaveMode=0
bAdditiveWaves=0
bTexWrap=1
bDarkenCenter=0
fWaveAlpha=0.0
fShader=0.0
zoom=1.0
rot=0.0
cx=0.5
cy=0.5
dx=0.0
dy=0.0
warp=0.01
sx=1.0
sy=1.0
ob_size=0.01
ib_size=0.01
mv_a=0.0

per_frame_1=q1=time*0.05;
per_frame_2=q2=bass_att;
per_frame_3=q3=mid_att;
per_frame_4=q4=treb_att;
per_frame_5=q5=sin(time*0.3);
per_frame_6=q6=cos(time*0.2);
per_frame_7=q7=sin(time*0.7)*0.5+0.5;

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`    float2 d = uv - 0.5;
warp_4=`    float zoom = 1.0 + q2 * 0.012;
warp_5=`    d *= zoom;
warp_6=`    float2 disp = float2(
warp_7=`        frac(sin(dot(d * 20.0, float2(127.1, 311.7))) * 43758.5453) - 0.5,
warp_8=`        frac(sin(dot(d * 20.0 + 5.0, float2(269.5, 183.3))) * 43758.5453) - 0.5);
warp_9=`    d += disp * 0.003;
warp_10=`    ret = tex2D(sampler_main, d + 0.5).xyz;
warp_11=`}

comp_1=`shader_body
comp_2=`{
comp_3=`    float2 p = uv * 14.0;
comp_4=`    float n1 = frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
comp_5=`    float n2 = frac(sin(dot(p * 1.7 + float2(3.1, 1.4), float2(269.5, 183.3))) * 43758.5453);
comp_6=`    float n3 = frac(sin(dot(p * 2.3 + float2(7.2, 5.6), float2(419.2, 137.7))) * 43758.5453);
comp_7=`    float n4 = frac(sin(dot(p * 3.1 + float2(11.3, 9.8), float2(171.3, 247.1))) * 43758.5453);
comp_8=`    float granite = (n1 + n2 * 0.5 + n3 * 0.25 + n4 * 0.125) / 1.875;
comp_9=`    float3 grey = float3(0.55, 0.53, 0.52);
comp_10=`    float3 brown = float3(0.45, 0.40, 0.36);
comp_11=`    float3 pink = float3(0.62, 0.55, 0.53);
comp_12=`    float3 slate = float3(0.48, 0.52, 0.55);
comp_13=`    float3 col = lerp(grey, brown, granite);
comp_14=`    col = lerp(col, pink, n2 * 0.35);
comp_15=`    col = lerp(col, slate, n3 * 0.2);
comp_16=`    float pulse = q2 * 0.06 + q3 * 0.03;
comp_17=`    col += float3(pulse * 0.5, pulse * 0.3, pulse * 0.15);
comp_18=`    float2 d = uv - 0.5;
comp_19=`    float r = length(d);
comp_20=`    float vig = smoothstep(0.72, 0.28, r);
comp_21=`    float3 fb = tex2D(sampler_main, uv).xyz;
comp_22=`    col = lerp(col, fb, 0.25);
comp_23=`    col *= 0.85 + 0.15 * vig;
comp_24=`    col = pow(col, float3(0.95, 0.98, 1.02));
comp_25=`    ret = saturate(col);
comp_26=`}
