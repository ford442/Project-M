# projectM CDN (projectm.1ink.us) Apache helpers.
#
# Legacy `.1ijs` / `.3ijs` glue is UTF-16/UTF-32 (iconv). When mod_deflate gzip-
# compresses those binaries, Chrome often reports net::ERR_CONTENT_DECODING_FAILED
# on the script (and on pthread workers that re-fetch the same URL), which then
# surfaces as RuntimeError: null function from `_init`. Prefer the UTF-8 `.js`
# glue (hosts default there now); also disable compression for the multi-byte
# legacy extensions.

<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI "\.(1ijs|3ijs)$" no-gzip dont-vary
</IfModule>

# Pthread / SharedArrayBuffer build requires cross-origin isolation on the host page.
# test.1ink.us sets these at the vhost; DreamHost production needs them here.
<IfModule mod_headers.c>
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Cross-Origin-Resource-Policy "cross-origin"
</IfModule>

# Explicit charset for multi-byte glue when clients still load them.
# Host pages (.1ink): deploy.py ships UTF-16 LE + BOM to match DreamHost's
# historical .1ink handling. Declaring charset=utf-8 here makes browsers
# mis-decode the page (blank / broken). Keep utf-16.
<IfModule mod_mime.c>
    AddType "application/javascript; charset=utf-16" .1ijs
    AddType "application/javascript; charset=utf-32" .3ijs
    AddType "application/javascript; charset=utf-8" .js
    AddType "text/html; charset=utf-16" .1ink
    AddType application/wasm .wasm
</IfModule>
