[preset00]
fRating=3.0
fGammaAdj=2.0
fDecay=0.98
fVideoEchoZoom=1.0
fVideoEchoAlpha=0.0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.001
fWaveScale=1.002
fWaveSmoothing=0.261
fWaveParam=0.0
fModWaveAlphaStart=0.5
fModWaveAlphaEnd=1.0
fWarpAnimSpeed=1.0
fWarpScale=1.331
fZoomExponent=1.0
fShader=1.0
zoom=1.0
rot=0.0
cx=0.5
cy=0.5
dx=0.0
dy=0.0

per_frame_1=// --- Prism tessellation controls ---
per_frame_2=rot = rot + 0.0015 + 0.002*bass_att;
per_frame_3=zoom = 0.995 + 0.015*sin(time*0.17) - 0.006*bass_att;
per_frame_4=
per_frame_5=// q1 controls the size of the glass-tile grid.
per_frame_6=q1 = 8 + 28*(0.5 + 0.5*sin(time*0.13));
per_frame_7=
per_frame_8=// q2 blends the smooth plasma with the faceted tile field.
per_frame_9=q2 = 0.35 + 0.45*(0.5 + 0.5*sin(time*0.31 + bass_att));
per_frame_10=
per_frame_11=// Shared oscillators for the pixel program.
per_frame_12=q3 = time*1.17 + rot*2.0;
per_frame_13=q4 = time*1.73 - rot*1.5;
per_frame_14=q5 = time*0.67 + mid_att*3.0;
per_frame_15=q6 = time*2.40 + treb_att*4.0;
per_frame_16=q7 = 4.0 + 4.0*(0.5 + 0.5*sin(time*0.21));
per_frame_17=q8 = 0.35 + 0.65*bass_att;

per_pixel_1=// --- Beat-reactive prism tessellation ---
per_pixel_2=
per_pixel_3=// Faceted UVs: each tile uses its cell center with a subtle audio wobble.
per_pixel_4=seg_x = (floor(uv.x * q1) + 0.5) / q1;
per_pixel_5=seg_y = (floor(uv.y * q1) + 0.5) / q1;
per_pixel_6=
per_pixel_7=// Blend smooth and segmented space, then recenter for radial work.
per_pixel_8=work_x = lerp(uv.x, seg_x, q2);
per_pixel_9=work_y = lerp(uv.y, seg_y, q2);
per_pixel_10=px = work_x - 0.5;
per_pixel_11=py = work_y - 0.5;
per_pixel_12=dist = sqrt(px*px + py*py);
per_pixel_13=ang = atan2(py, px);
per_pixel_14=
per_pixel_15=// Kaleidoscope spokes and nested rings.
per_pixel_16=spoke = 0.5 + 0.5*cos(ang*q7 + q3 + sin(dist*18.0 - q4));
per_pixel_17=ring = 0.5 + 0.5*sin(dist*(34.0 + 10.0*q8) - q6 + spoke*2.4);
per_pixel_18=iris = pow(max(0.0, 1.0 - dist*1.55), 2.0);
per_pixel_19=
per_pixel_20=// Thin grid glints on the glass-cell boundaries.
per_pixel_21=grid_x = 1.0 - abs(sin(uv.x*q1*3.14159));
per_pixel_22=grid_y = 1.0 - abs(sin(uv.y*q1*3.14159));
per_pixel_23=grid = pow(max(grid_x, grid_y), 12.0);
per_pixel_24=
per_pixel_25=// Cross-flow plasma adds motion inside each tile.
per_pixel_26=flow_a = 0.5 + 0.5*sin((work_x + work_y)*10.0 + q3 + ring);
per_pixel_27=flow_b = 0.5 + 0.5*cos((work_x - work_y)*13.0 - q4 + spoke);
per_pixel_28=flow_c = 0.5 + 0.5*sin(dist*24.0 - q5 + flow_a*1.8);
per_pixel_29=
per_pixel_30=// Palette: electric cyan, hot magenta, gold, and deep violet shadows.
per_pixel_31=base_r = 0.10 + 0.42*flow_b + 0.36*ring + 0.35*grid;
per_pixel_32=base_g = 0.16 + 0.55*flow_a + 0.22*spoke + 0.18*iris;
per_pixel_33=base_b = 0.28 + 0.52*flow_c + 0.30*spoke + 0.28*grid;
per_pixel_34=
per_pixel_35=gold = pow(ring*spoke, 3.0) * (0.65 + 0.75*bass_att);
per_pixel_36=spark = pow(max(0.0, sin((ang + dist*5.0)*18.0 + q6)), 18.0) * treb_att * (0.35 + iris);
per_pixel_37=vignette = 0.42 + 0.58*max(0.0, 1.0 - dist*1.15);
per_pixel_38=boost = 1.05 + 0.65*bass_att + 0.25*mid_att;
per_pixel_39=
per_pixel_40=final_r = (base_r + gold*1.25 + spark*1.00) * vignette * boost;
per_pixel_41=final_g = (base_g + gold*0.78 + spark*0.82) * vignette * boost;
per_pixel_42=final_b = (base_b + gold*0.28 + spark*1.35) * vignette * boost;
per_pixel_43=
per_pixel_44=ret = float3(min(final_r, 1.0), min(final_g, 1.0), min(final_b, 1.0));
