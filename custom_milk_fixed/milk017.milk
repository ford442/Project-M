// CHANGELOG 2026-06-19 (initial)
// - Aurora Borealis: flowing sine-field warp + spectrum wave curtain + additive aurora comp
// Target: PSVERSION_WARP=3 PSVERSION_COMP=3 | Pattern: docs/milk011_creative_brief.md
// Audio: q2=bass_att curtain width, q3=mid_att hue drift, q4=treb_att shimmer
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Aurora Borealis
fRating=3.0
fGammaAdj=1.8
fDecay=0.975
fVideoEchoZoom=1.0
fVideoEchoAlpha=0.0
nWaveMode=0
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=1
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bBrighten=0
bDarken=0
fWaveAlpha=0.0
fShader=0.0
zoom=1.0
rot=0.0
cx=0.5
cy=0.5
dx=0.0
dy=0.0
warp=0.01
sx=1.0
sy=1.0
ob_size=0.01
ib_size=0.01
mv_a=0.0

per_frame_1=q1=time*0.4;
per_frame_2=q2=bass_att;
per_frame_3=q3=mid_att;
per_frame_4=q4=treb_att;
per_frame_5=q5=0.5+0.5*sin(time*0.2);
per_frame_6=q6=0.5+0.5*cos(time*0.17);

wavecode_0_enabled=1
wavecode_0_samples=128
wavecode_0_bSpectrum=1
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_r=0.3
wavecode_0_g=0.9
wavecode_0_b=0.7
wavecode_0_a=0.5
wave_0_per_point1=ang=sample*6.283+q1;
wave_0_per_point2=rad=0.35+value1*0.15+q2*0.1;
wave_0_per_point3=x=0.5+cos(ang)*rad*0.5;
wave_0_per_point4=y=0.5+sin(ang)*rad*0.5;
wave_0_per_point5=r=0.2+q5*0.5;
wave_0_per_point6=g=0.7+q6*0.3;
wave_0_per_point7=b=0.5+0.5*sin(q1*2.0);

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`    float2 d = (uv - 0.5) * aspect.xy;
warp_4=`    float ripple = sin(d.x * 8.0 + q1 * 3.0) * 0.02 * (0.5 + q2);
warp_5=`    d.y += ripple;
warp_6=`    d.x += sin(d.y * 6.0 - q1 * 2.0) * 0.015 * q3;
warp_7=`    float2 wuv = d * aspect.zw + 0.5;
warp_8=`    ret = tex2D(sampler_main, wuv).xyz;
warp_9=`}

comp_1=`shader_body
comp_2=`{
comp_3=`    float3 col = tex2D(sampler_main, uv).xyz;
comp_4=`    float curtain = sin(uv.x * 12.0 + q1 * 4.0) * 0.5 + 0.5;
comp_5=`    curtain *= smoothstep(0.15, 0.85, uv.y);
comp_6=`    float3 aurora = float3(0.1 + q5 * 0.4, 0.6 + q3 * 0.4, 0.4 + q6 * 0.5);
comp_7=`    col += aurora * curtain * (0.2 + q2 * 0.5);
comp_8=`    float shimmer = pow(curtain, 3.0) * q4;
comp_9=`    col += float3(0.6, 0.9, 1.0) * shimmer * 0.25;
comp_10=`    float2 d = uv - 0.5;
comp_11=`    col *= smoothstep(0.9, 0.2, length(d));
comp_12=`    ret = saturate(col);
comp_13=`}
