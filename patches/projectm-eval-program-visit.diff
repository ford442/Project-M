diff -ruN '--exclude=build' '--exclude=configure.log' pe-orig/tests/TreeInspectionTest.cpp pe/tests/TreeInspectionTest.cpp
--- a/tests/TreeInspectionTest.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/tests/TreeInspectionTest.cpp	2026-09-25 11:00:55.272302841 +0200
@@ -0,0 +1,152 @@
+#include <projectm-eval.h>
+
+#include <gtest/gtest.h>
+
+#include <string>
+#include <vector>
+
+namespace {
+
+/** @brief Compiles code on a fresh context and destroys both afterwards. */
+class TreeInspection : public testing::Test
+{
+protected:
+    void SetUp() override
+    {
+        m_context = projectm_eval_context_create(nullptr, &m_registers);
+        m_x = projectm_eval_context_register_variable(m_context, "x");
+    }
+
+    void TearDown() override
+    {
+        for (auto* code : m_code)
+        {
+            projectm_eval_code_destroy(code);
+        }
+        projectm_eval_context_destroy(m_context);
+    }
+
+    auto Compile(const char* source) -> projectm_eval_code*
+    {
+        auto* code = projectm_eval_code_compile(m_context, source);
+        EXPECT_NE(code, nullptr) << projectm_eval_get_error(m_context, nullptr, nullptr);
+        if (code != nullptr)
+        {
+            m_code.push_back(code);
+        }
+        return code;
+    }
+
+    PRJM_EVAL_F m_registers[100]{};
+    projectm_eval_context* m_context{};
+    PRJM_EVAL_F* m_x{};
+    std::vector<projectm_eval_code*> m_code;
+};
+
+} // namespace
+
+TEST_F(TreeInspection, EmptyProgramHasNoRoot)
+{
+    auto* code = Compile("// only a comment");
+    ASSERT_NE(code, nullptr);
+    EXPECT_EQ(projectm_eval_code_root(code), nullptr);
+
+    int visited = 0;
+    projectm_eval_code_visit(code, [](const projectm_eval_node*, int, void* count) {
+        (*static_cast<int*>(count))++;
+        return 1; }, &visited);
+    EXPECT_EQ(visited, 0);
+}
+
+TEST_F(TreeInspection, StatementsAreChildrenOfAList)
+{
+    auto* code = Compile("a = x + 1; b = sin(a) * 2;");
+    const auto* root = projectm_eval_code_root(code);
+    ASSERT_NE(root, nullptr);
+    ASSERT_EQ(projectm_eval_node_operation(root), PROJECTM_EVAL_OP_LIST);
+    ASSERT_EQ(projectm_eval_node_child_count(root), 2);
+    EXPECT_EQ(projectm_eval_node_child(root, 2), nullptr);
+
+    const auto* first = projectm_eval_node_child(root, 0);
+    ASSERT_EQ(projectm_eval_node_operation(first), PROJECTM_EVAL_OP_ASSIGN);
+    ASSERT_EQ(projectm_eval_node_child_count(first), 2);
+
+    const auto* target = projectm_eval_node_child(first, 0);
+    ASSERT_EQ(projectm_eval_node_operation(target), PROJECTM_EVAL_OP_VARIABLE);
+    EXPECT_STREQ(projectm_eval_code_variable_name(code, projectm_eval_node_variable(target)), "a");
+
+    const auto* sum = projectm_eval_node_child(first, 1);
+    ASSERT_EQ(projectm_eval_node_operation(sum), PROJECTM_EVAL_OP_ADD);
+    EXPECT_EQ(projectm_eval_node_variable(projectm_eval_node_child(sum, 0)), m_x)
+        << "a registered variable is recognisable by its address";
+    EXPECT_EQ(projectm_eval_node_operation(projectm_eval_node_child(sum, 1)), PROJECTM_EVAL_OP_CONSTANT);
+    EXPECT_EQ(projectm_eval_node_constant(projectm_eval_node_child(sum, 1)), 1.0);
+}
+
+TEST_F(TreeInspection, EverySpellingOfAnOperationIsTheSameOperation)
+{
+    auto* code = Compile("a = if(x, 1, 2); b = _if(x, 1, 2); c = int(x); d = floor(x);"
+                         "e = megabuf(1); f = _mem(2); g = gmegabuf(3);");
+    const auto* root = projectm_eval_code_root(code);
+    ASSERT_EQ(projectm_eval_node_child_count(root), 7);
+
+    const auto value = [root](int statement) {
+        return projectm_eval_node_child(projectm_eval_node_child(root, statement), 1);
+    };
+    EXPECT_EQ(projectm_eval_node_operation(value(0)), PROJECTM_EVAL_OP_IF);
+    EXPECT_EQ(projectm_eval_node_operation(value(1)), PROJECTM_EVAL_OP_IF);
+    EXPECT_EQ(projectm_eval_node_operation(value(2)), PROJECTM_EVAL_OP_FLOOR);
+    EXPECT_EQ(projectm_eval_node_operation(value(3)), PROJECTM_EVAL_OP_FLOOR);
+    EXPECT_EQ(projectm_eval_node_operation(value(4)), PROJECTM_EVAL_OP_MEMORY);
+    EXPECT_EQ(projectm_eval_node_operation(value(5)), PROJECTM_EVAL_OP_MEMORY);
+    EXPECT_EQ(projectm_eval_node_operation(value(6)), PROJECTM_EVAL_OP_MEMORY);
+    EXPECT_FALSE(projectm_eval_node_is_global_memory(code, value(4)));
+    EXPECT_TRUE(projectm_eval_node_is_global_memory(code, value(6)));
+}
+
+TEST_F(TreeInspection, RegistersAreNamed)
+{
+    auto* code = Compile("reg07 = x;");
+    const auto* target = projectm_eval_node_child(projectm_eval_code_root(code), 0);
+    ASSERT_EQ(projectm_eval_node_operation(target), PROJECTM_EVAL_OP_VARIABLE);
+    EXPECT_EQ(projectm_eval_node_variable(target), &m_registers[7]);
+    EXPECT_STREQ(projectm_eval_code_variable_name(code, &m_registers[7]), "reg07");
+}
+
+TEST_F(TreeInspection, OneStatementCanRunOnItsOwn)
+{
+    auto* code = Compile("a = x * 2; b = a + 1;");
+    const auto* root = projectm_eval_code_root(code);
+    *m_x = 5.0;
+
+    // Only the second statement: 'a' still holds whatever it held.
+    EXPECT_EQ(projectm_eval_node_execute(projectm_eval_node_child(root, 1)), 1.0);
+    EXPECT_EQ(projectm_eval_node_execute(projectm_eval_node_child(root, 0)), 10.0);
+    EXPECT_EQ(projectm_eval_node_execute(projectm_eval_node_child(root, 1)), 11.0);
+    EXPECT_EQ(projectm_eval_code_execute(code), 11.0);
+}
+
+TEST_F(TreeInspection, VisitIsPreOrderAndCanPrune)
+{
+    auto* code = Compile("a = sin(x); b = cos(x);");
+
+    struct Visit
+    {
+        std::vector<std::pair<projectm_eval_operation, int>> nodes;
+    } visit;
+    projectm_eval_code_visit(code, [](const projectm_eval_node* node, int depth, void* data) {
+        auto& nodes = static_cast<Visit*>(data)->nodes;
+        nodes.emplace_back(projectm_eval_node_operation(node), depth);
+        // Do not descend into the second statement.
+        return nodes.size() < 5 ? 1 : 0; }, &visit);
+
+    const std::vector<std::pair<projectm_eval_operation, int>> expected = {
+        {PROJECTM_EVAL_OP_LIST, 0},
+        {PROJECTM_EVAL_OP_ASSIGN, 1},
+        {PROJECTM_EVAL_OP_VARIABLE, 2},
+        {PROJECTM_EVAL_OP_SIN, 2},
+        {PROJECTM_EVAL_OP_VARIABLE, 3},
+        {PROJECTM_EVAL_OP_ASSIGN, 1},
+    };
+    EXPECT_EQ(visit.nodes, expected);
+}
