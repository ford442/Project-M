// Signature Series | shader_swarm | Candy World
// tags: candy, swarm, onsets, sections, pm-rhythm, medium
// author: projectM-signature-rhythm-2026-10
// project: candy-world
// music: pop / electro / anything with a kick and hi-hats
// Showcase for projectM's musical-time variables (docs/MILK_PRESET_GUIDE.md, "Musical Time"):
// the kick (pm_onset_lo) blooms the kaleidoscope, the hi-hats (pm_onset_hi) sparkle in the
// swarm, brighter music (pm_centroid) shifts the candy palette, the fold count changes with
// each section (pm_section), and a downbeat flash lands on the "one" (pm_bar_phase).
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Shader Swarm Onsets
fRating=4.500000
fGammaAdj=1.800000
fDecay=0.965000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nWaveMode=0
bAdditiveWaves=0
fWaveAlpha=0.001000
fWarpScale=1.000000
zoom=1.000000
rot=0.000000
warp=0.000000
cx=0.500000
cy=0.500000
mv_a=0.000000
wavecode_0_enabled=1
wavecode_0_samples=160
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.000000
wavecode_0_r=1.000000
wavecode_0_g=1.000000
wavecode_0_b=1.000000
wavecode_0_a=1.000000
wave_0_per_point1=t = sample*6.2832*4 + time*0.6;
wave_0_per_point2=rr = 0.06 + 0.32*sample + 0.04*sin(sample*37 + time*2)*(0.3 + pm_onset_hi);
wave_0_per_point3=x = 0.5 + rr*cos(t)*0.75; y = 0.5 + rr*sin(t);
wave_0_per_point4=a = 0.45 + 0.55*pm_onset_hi;
wave_0_per_point5=r = 0.9 + 0.1*sin(t); g = 0.45 + 0.45*pm_centroid; b = 1.0;
shapecode_0_enabled=1
shapecode_0_sides=5
shapecode_0_additive=1
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=12
shapecode_0_x=0.500000
shapecode_0_y=0.500000
shapecode_0_rad=0.030000
shapecode_0_ang=0.000000
shapecode_0_r=1.000000
shapecode_0_g=0.400000
shapecode_0_b=0.800000
shapecode_0_a=0.800000
shapecode_0_r2=1.000000
shapecode_0_g2=0.900000
shapecode_0_b2=0.300000
shapecode_0_a2=0.000000
shapecode_0_border_a=0.000000
shape_0_per_frame1=k = instance/num_inst*6.2832 + time*0.4;
shape_0_per_frame2=d = 0.12 + 0.18*pm_onset_lo;
shape_0_per_frame3=x = 0.5 + d*cos(k)*0.75; y = 0.5 + d*sin(k);
shape_0_per_frame4=rad = 0.015 + 0.05*pm_onset_lo; ang = k + time;
shape_0_per_frame5=a = 0.25 + 0.75*pm_onset_lo; g = 0.3 + 0.5*pm_centroid;

per_frame_1=q1 = pm_onset_lo;
per_frame_2=q2 = pm_onset_hi;
per_frame_3=q3 = pm_centroid;
per_frame_4=q4 = 3 + pm_section % 4;
per_frame_5=q5 = pow(1 - pm_bar_phase, 8)*pm_rhythm_conf;
per_frame_6=q6 = time*0.05;
per_frame_7=zoom = 1.0 - 0.02*q1;


warp_1=`shader_body
warp_2=`{
warp_3=`float2 uvc=uv-0.5;
warp_4=`float r=length(uvc);
warp_5=`float seg=6.2831853/q4;
warp_6=`float a=atan2(uvc.y,uvc.x)+q6;
warp_7=`a=abs(a-floor(a/seg)*seg-seg*0.5);
warp_8=`float2 kuv=float2(cos(a),sin(a))*r*(0.99-0.03*q1)+0.5;
warp_9=`float3 col=tex2D(sampler_main,lerp(uv,kuv,0.45)).xyz;
warp_10=`ret=col*0.972;
warp_11=`}

comp_1=`shader_body
comp_2=`{
comp_3=`float3 col=tex2D(sampler_main,uv).xyz;
comp_4=`float3 candy=float3(1.0,0.45+0.4*q3,0.8-0.3*q3);
comp_5=`col=col*candy*(1.15+0.6*q1);
comp_6=`float2 cell=floor(uv*texsize.xy*0.25);
comp_7=`float h=frac(sin(dot(cell,float2(12.9898,78.233)))*43758.5453);
comp_8=`col+=step(0.992-0.04*q2,h)*q2*float3(1.0,0.9,1.0);
comp_9=`col+=float3(0.3,0.08,0.28)*q5;
comp_10=`ret=saturate(col);
comp_11=`}
