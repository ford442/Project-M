{
  "$comment": "Regression + Signature Series manifest for AI agents. See docs/SIGNATURE_SERIES_WORKFLOW.md and docs/agents/kimi_preset_authoring_plan.md.",
  "validator": "scripts/kimi_validate_preset.sh",
  "upgrader": "scripts/kimi_upgrade_preset.sh",
  "auditor": "scripts/audit_presets.mjs",
  "toml_converter": "scripts/toml_to_milk.mjs",
  "workflow_doc": "docs/SIGNATURE_SERIES_WORKFLOW.md",
  "directories": {
    "parser_fixtures": {
      "path": "presets/tests",
      "description": "Small fixtures exercising specific parser/shader features; covered by the default projectM-unittest PresetCompat run."
    },
    "regression_corpus": {
      "path": "presets/custom",
      "description": "Curated AI-authored presets used as the fork's regression set. Opt-in via PROJECTM_TEST_CUSTOM_MILK_FIXED=1."
    },
    "drafts": {
      "path": "presets/drafts",
      "description": "TOML or WIP .milk drafts before promotion to presets/custom/."
    },
    "quarantine": {
      "path": "presets/quarantine",
      "description": "Presets removed from the curated corpus; re-promote via scripts/promote_preset.mjs after WASM capture passes."
    },
    "bulk_corpus": {
      "path": "presets/weeks",
      "description": "Large community preset corpus; validate via PROJECTM_PRESET_COMPAT_DIR before bulk upgrades."
    }
  },
  "agent_tasks": {
    "generate": {
      "prompt": "docs/agents/grok/preset_generation_prompt.md",
      "briefs": "docs/agents/grok/signature_series_briefs.md",
      "output_dir": "presets/custom",
      "naming": "<family_prefix>_<descriptor>.milk"
    },
    "review": {
      "checklist": "docs/agents/grok/preset_review_checklist.md",
      "code_review": "docs/agents/grok/code_review_checklist.md"
    },
    "validate": {
      "static": "node scripts/audit_presets.mjs <file>",
      "transpile": "scripts/kimi_validate_preset.sh <file>",
      "demo": "html/projectm-core.html?devPreset=1&localPresets=1"
    },
    "optimize": {
      "doc": "docs/PERFORMANCE.md",
      "bench": "./optimize.sh --bench"
    },
    "publish": {
      "manifest": "node scripts/generate_custom_preset_manifest.mjs",
      "screenshots": "scripts/capture_custom_milk_screenshots.mjs",
      "promote": "node scripts/promote_preset.mjs"
    }
  },
  "project_ties": {
    "zephyr-orbital": {
      "prefix": "orbital_rave_",
      "mood": "neon tunnels, rave energy, fast orbit",
      "audio": ["bass_att", "treb_att"],
      "presets": ["presets/custom/orbital_rave_zephyr.milk", "presets/custom/orbital_rave_neon.milk", "presets/custom/orbital_rave_aurora.milk", "presets/custom/orbital_rave_beatlock.milk"]
    },
    "watershed": {
      "prefix": "cinematic_pedal_steel_",
      "mood": "warm cinematic, pedal steel, slow pans",
      "audio": ["mid_att", "bass_att"],
      "presets": ["presets/custom/cinematic_pedal_steel_watershed.milk", "presets/custom/cinematic_pedal_steel_horizon.milk", "presets/custom/cinematic_pedal_steel_rain.milk"]
    },
    "redwood": {
      "prefix": "redwood_dreams_",
      "mood": "forest, mist, nature ambient",
      "audio": ["mid", "vol"],
      "presets": ["presets/custom/redwood_dreams_canopy.milk", "presets/custom/redwood_dreams_fog.milk", "presets/custom/redwood_dreams_firefly.milk"]
    },
    "candy-world": {
      "prefix": "shader_swarm_",
      "mood": "playful candy colors, particle swarms",
      "audio": ["treb_att", "bass_att"],
      "presets": ["presets/custom/shader_swarm_candy.milk", "presets/custom/shader_swarm_reactive.milk", "presets/custom/shader_swarm_galaxy.milk", "presets/custom/shader_swarm_onsets.milk"]
    }
  },
  "signature_series": {
    "workflow": "docs/SIGNATURE_SERIES_WORKFLOW.md",
    "target_fps": 60,
    "batch_size_goal": "5-10",
    "prefixes": ["orbital_rave_", "cinematic_pedal_steel_", "redwood_dreams_", "shader_swarm_"],
    "presets": [
      "presets/custom/orbital_rave_zephyr.milk",
      "presets/custom/orbital_rave_neon.milk",
      "presets/custom/orbital_rave_aurora.milk",
      "presets/custom/cinematic_pedal_steel_watershed.milk",
      "presets/custom/cinematic_pedal_steel_horizon.milk",
      "presets/custom/cinematic_pedal_steel_rain.milk",
      "presets/custom/redwood_dreams_canopy.milk",
      "presets/custom/redwood_dreams_fog.milk",
      "presets/custom/redwood_dreams_firefly.milk",
      "presets/custom/shader_swarm_candy.milk",
      "presets/custom/shader_swarm_reactive.milk",
      "presets/custom/shader_swarm_galaxy.milk",
      "presets/custom/orbital_rave_beatlock.milk",
      "presets/custom/shader_swarm_onsets.milk"
    ]
  },
  "known_good": [
