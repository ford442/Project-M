// CHANGELOG 2026-06-19 — WASM upgrade
// - Replaced unsupported draw_shape/loop with shapecode_0 num_inst=30 rainbow orbit
// - Added MILKDROP_PRESET_VERSION=200 + PSVERSION_WARP/COMP=3
// Author: projectM AI | Rainbow Orbit Glow
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Rainbow Orbit Glow
fRating=5.0
fGammaAdj=2.0
fDecay=0.950
fVideoEchoZoom=1.0
fVideoEchoAlpha=0.0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bTexWrap=1
bDarkenCenter=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.0
fShader=0.0
zoom=1.0
rot=0.0
cx=0.5
cy=0.5
dx=0.0
dy=0.0
warp=0.01
sx=1.0
sy=1.0
wave_a=0.0
ob_size=0.01
ib_size=0.01
mv_a=0.0

per_frame_1=q1=bass_att;
per_frame_2=q2=0.4+q1*0.2;

shapecode_0_enabled=1
shapecode_0_sides=20
shapecode_0_additive=1
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=30
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_rad=0.05
shapecode_0_a=0.2
shapecode_0_border_a=0.0
shape_0_per_frame1=angle=(instance/30.0)*6.283+time*0.5;
shape_0_per_frame2=hue=frac(instance/30.0+time*0.1);
shape_0_per_frame3=x=0.5+cos(angle)*q2;
shape_0_per_frame4=y=0.5+sin(angle)*q2;
shape_0_per_frame5=rad=0.05+q1*0.1;
shape_0_per_frame6=a=0.1+q1*0.3;
shape_0_per_frame7=r=0.5+0.5*cos(6.283*hue);
shape_0_per_frame8=g=0.5+0.5*cos(6.283*hue+2.094);
shape_0_per_frame9=b=0.5+0.5*cos(6.283*hue+4.188);

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz;
warp_4=`}

comp_1=`shader_body
comp_2=`{
comp_3=`    float bg = 0.45 + 0.25 * sin(uv.x * 4.0 + time * 0.11) * cos(uv.y * 4.0 + time * 0.07);
comp_4=`    float3 col = float3(min(bg * 0.25, 1.0), min(bg * 0.9, 1.0), min(bg * 1.3, 1.0));
comp_5=`    float3 fb = tex2D(sampler_main, uv).xyz;
comp_6=`    ret = saturate(lerp(col, fb, 0.4));
comp_7=`}
