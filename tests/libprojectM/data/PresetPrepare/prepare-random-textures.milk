[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
fDecay=0.9
// Random texture slots: unprefixed, prefixed with matching files, and a slot shared between
// the warp and composite shader (the composite reuses the warp's pick).
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = tex2D(sampler_main, uv).xyz * 0.5;
warp_4=`  ret += tex2D(sampler_rand00, uv).xyz * 0.1;
warp_5=`  ret += tex2D(sampler_rand01_pm, uv).xyz * texsize_rand01_pm.z;
warp_6=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  ret = tex2D(sampler_main, uv).xyz;
comp_4=`  ret += tex2D(sampler_rand00, uv).xyz * 0.1;
comp_5=`  ret += tex2D(sampler_rand03_pm, uv).xyz * 0.1;
comp_6=`}
