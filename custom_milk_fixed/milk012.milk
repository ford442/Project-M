// CHANGELOG 2026-06-12 (Liquid Mercury WASM upgrade)
// - Added MILKDROP_PRESET_VERSION=200 + PSVERSION_WARP/COMP=3 for GLES3 HLSL-9
// - Aspect-corrected centered UVs in warp using aspect.xy; radial/barrel/ripple displacement unchanged
// - Per-frame q1-q12 pre-cache audio+LFO values; q5/q6/q7 now 0..1 biased per brief
// - Composite applies cool-metal palette, treb-reactive specular highlight, vignette and final saturate()
// - Preserved wavecode_0 (bass-reactive PCM scratch) and shapecode_0 (specular pool disc)
// Target: PSVERSION_WARP=3 PSVERSION_COMP=3 | Brief: docs/milk012_creative_brief.md
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Liquid Mercury
author=projectM AI
fRating=3.000000
fGammaAdj=2.000000
fDecay=0.990000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
fWaveAlpha=0.000000
fWaveScale=1.000000
fWaveSmoothing=0.500000
fWaveParam=0.000000
fModWaveAlphaStart=0.000000
fModWaveAlphaEnd=0.000000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=0.000000
zoom=0.995000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.010000
sx=1.000000
sy=1.000000
wave_r=0.800000
wave_g=0.800000
wave_b=0.900000
wave_x=0.500000
wave_y=0.500000
per_frame_1=q1=time;
per_frame_2=q2=bass_att;
per_frame_3=q3=mid_att;
per_frame_4=q4=treb_att;
per_frame_5=q5=0.5+0.5*sin(time*0.5);
per_frame_6=q6=0.5+0.5*cos(time*0.3);
per_frame_7=q7=0.5+0.5*sin(time*1.1);
per_frame_8=q8=bass;
per_frame_9=q9=0.5+0.5*sin(time*0.2);
per_frame_10=q10=0.5+0.5*cos(time*0.15);
per_frame_11=q11=q2*0.1;
per_frame_12=q12=q3*0.08;
per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
wavecode_0_enabled=1
wavecode_0_samples=200
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=0
wavecode_0_r=0.800000
wavecode_0_g=0.850000
wavecode_0_b=0.950000
wavecode_0_a=0.400000
wavecode_0_per_point1=x=sample;
wavecode_0_per_point2=y=0.5+value1*(0.2+q8*0.1);
wavecode_0_per_point3=r=0.8;
wavecode_0_per_point4=g=0.85;
wavecode_0_per_point5=b=0.95;
shapecode_0_enabled=1
shapecode_0_sides=32
shapecode_0_additive=0
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_x=0.500000
shapecode_0_y=0.500000
shapecode_0_rad=0.100000
shapecode_0_ang=0.000000
shapecode_0_tex_ang=0.000000
shapecode_0_tex_zoom=1.000000
shapecode_0_r=0.900000
shapecode_0_g=0.900000
shapecode_0_b=1.000000
shapecode_0_a=0.200000
shapecode_0_r2=0.900000
shapecode_0_g2=0.900000
shapecode_0_b2=1.000000
shapecode_0_a2=0.100000
shapecode_0_border_r=0.700000
shapecode_0_border_g=0.750000
shapecode_0_border_b=0.850000
shapecode_0_border_a=0.300000
shapecode_0_per_frame1=rad=0.05+q2*0.08;
shapecode_0_per_frame2=r=0.8+q2*0.2;
shapecode_0_per_frame3=g=0.8+q2*0.15;
shapecode_0_per_frame4=b=0.9+q2*0.1;
warp_1=`shader_body
warp_2=`{
warp_3=`float2 c = (uv - 0.5) * aspect.xy;
warp_4=`float r = length(c);
warp_5=`float a = atan2(c.y, c.x);
warp_6=`float t = q1;
warp_7=`float zscale = 1.0 + q2 * 0.1 + sin(t * 0.4) * 0.02;
warp_8=`c *= zscale;
warp_9=`float barrel = 1.0 + r * r * 0.25;
warp_10=`c *= barrel;
warp_11=`a += t * 0.04 + q2 * 0.06;
warp_12=`float rippleR = sin(r * 20.0 - t * 2.8 + q2 * 3.0) * (0.008 + q2 * 0.012);
warp_13=`float rippleA = cos(a * 5.0 + t * 1.3) * (0.005 + q3 * 0.008);
warp_14=`float rippleF = sin(r * 35.0 - t * 5.0) * 0.003;
warp_15=`c += float2(cos(a), sin(a)) * (rippleR + rippleF);
warp_16=`c += float2(-sin(a), cos(a)) * rippleA;
warp_17=`float2 s = c * aspect.zw + 0.5;
warp_18=`float3 col = tex2D(sampler_main, s).xyz;
warp_19=`ret = col;
warp_20=`}
comp_1=`shader_body
comp_2=`{
comp_3=`float3 col = tex2D(sampler_main, uv).xyz;
comp_4=`float lum = (col.x + col.y + col.z) * 0.333;
comp_5=`float3 darkMetal = float3(0.02, 0.02, 0.03);
comp_6=`float3 lightMetal = float3(0.85, 0.88, 0.95);
comp_7=`float3 specular = float3(0.98, 0.99, 1.0);
comp_8=`float metal = pow(lum, 0.8);
comp_9=`float3 outCol = lerp(darkMetal, lightMetal, metal);
comp_10=`float spec = pow(smoothstep(0.6, 1.0, lum), 4.0);
comp_11=`outCol = lerp(outCol, specular, spec * (0.6 + 0.4 * q4));
comp_12=`float vig = smoothstep(0.8, 0.3, length(uv - 0.5));
comp_13=`outCol *= 0.85 + 0.15 * vig;
comp_14=`outCol = pow(outCol, 1.15);
comp_15=`ret = saturate(outCol);
comp_16=`}
