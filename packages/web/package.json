{
  "name": "@projectm/web",
  "version": "0.1.0",
  "description": "Embeddable projectM web components and context API for music visualizers",
  "license": "LGPL-2.1-only",
  "type": "module",
  "sideEffects": [
    "./dist/projectm-element.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./types/entry.d.ts",
      "default": "./dist/projectm-element.js"
    },
    "./element": {
      "types": "./types/element.d.ts",
      "default": "./dist/projectm-element.js"
    },
    "./context": {
      "types": "./types/context.d.ts",
      "default": "./dist/projectm-context.js"
    },
    "./wasm-version": {
      "types": "./types/wasm-version.d.ts",
      "default": "./dist/projectm-wasm-version.js"
    },
    "./wasm-api": {
      "types": "./dist/generated/projectm-wasm-api.ts",
      "default": "./dist/generated/projectm-wasm-api.js"
    }
  },
  "types": "./types/entry.d.ts",
  "peerDependencies": {},
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/projectM-visualizer/projectm.git",
    "directory": "packages/web"
  },
  "keywords": [
    "projectm",
    "milkdrop",
    "visualizer",
    "web-component",
    "wasm"
  ]
}
