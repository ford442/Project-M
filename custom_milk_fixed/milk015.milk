// CHANGELOG 2026-06-12 (Black-Hole Accretion Disk WASM upgrade)
// - Added MILKDROP_PRESET_VERSION=200 + PSVERSION=3 + PSVERSION_WARP/COMP=3 for GLES3 HLSL-9
// - Moved fDecay=0.980000 to preset params; added per_pixel zoom/rot/warp defaults
// - Aspect-corrected gravitational warp + Doppler accretion-disk composite with shader_body wrappers
// - Reduced wavecode_0_samples from 512 to 128 for WebGL performance
// Target: PSVERSION_WARP=3 PSVERSION_COMP=3 | Brief: docs/milk015_creative_brief.md
[preset00]
presetname=Accretion Disk
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
fRating=3.000000
fGammaAdj=1.000000
fDecay=0.980000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.800000
fWaveScale=1.000000
fWaveSmoothing=0.500000
fWaveParam=0.000000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=0.000000
zoom=1.000000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.010000
sx=1.000000
sy=1.000000
wave_r=0.000000
wave_g=0.000000
wave_b=0.000000
wave_x=0.500000
wave_y=0.500000
ob_size=0.000000
ob_r=0.000000
ob_g=0.000000
ob_b=0.000000
ob_a=0.000000
ib_size=0.000000
ib_r=0.250000
ib_g=0.250000
ib_b=0.250000
ib_a=0.000000
wavecode_0_enabled=1
wavecode_0_samples=128
wavecode_0_sep=0
wavecode_0_bSpectrum=1
wavecode_0_bUseDots=1
wavecode_0_bDrawThick=0
wavecode_0_bAdditive=1
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.500000
wavecode_0_r=1.000000
wavecode_0_g=0.800000
wavecode_0_b=0.500000
wavecode_0_a=0.700000
wave_0_per_point1=ang=sample*6.2832+q1
wave_0_per_point2=rad=0.25+value1*0.15
wave_0_per_point3=x=cos(ang)*rad*0.5+0.5
wave_0_per_point4=y=sin(ang)*rad*0.5+0.5
wave_0_per_point5=r=0.9+0.1*sin(q1*3)
wave_0_per_point6=g=0.5+0.3*sin(q1*2+1)
wave_0_per_point7=b=0.2+0.2*sin(q1*5+2)
wave_0_per_point8=a=1
shapecode_0_enabled=1
shapecode_0_sides=100
shapecode_0_additive=1
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=1
shapecode_0_x=0.500000
shapecode_0_y=0.500000
shapecode_0_rad=0.080000
shapecode_0_ang=0.000000
shapecode_0_r=0.000000
shapecode_0_g=0.000000
shapecode_0_b=0.000000
shapecode_0_a=0.800000
shapecode_0_r2=0.000000
shapecode_0_g2=0.000000
shapecode_0_b2=0.000000
shapecode_0_a2=0.800000
shapecode_0_border_r=1.000000
shapecode_0_border_g=0.600000
shapecode_0_border_b=0.200000
shapecode_0_border_a=0.600000
shape_0_per_frame1=rad=q6+q5*0.02
shape_0_per_frame2=r=0
shape_0_per_frame3=g=0
shape_0_per_frame4=b=0
shape_0_per_frame5=a=0.9+q5*0.1
shape_0_per_frame6=border_r=0.9+0.1*sin(q1*4)
shape_0_per_frame7=border_g=0.5+0.2*sin(q1*3+1)
shape_0_per_frame8=border_b=0.1+0.1*sin(q1*5+2)
per_frame_1=zoom=1.000000
per_frame_2=rot=0.000000
per_frame_3=sx=1.000000
per_frame_4=sy=1.000000
per_frame_5=wave_a=0.000000
per_frame_6=q1=time*0.12
per_frame_7=q2=bass_att
per_frame_8=q3=mid_att
per_frame_9=q4=treb_att
per_frame_10=q5=bass
per_frame_11=q6=0.06+q2*0.03
per_frame_12=q7=0.12+q3*0.04
per_frame_13=q8=0.35+q4*0.08
per_frame_14=q9=0.15+q5*0.06
per_frame_15=q10=0.25+q2*0.15
per_frame_16=q11=sin(q1*2.0)
per_frame_17=q12=0.5+q5*0.4
per_pixel_1=zoom=1.0
per_pixel_2=rot=0.0
per_pixel_3=warp=0.01
warp_1=`shader_body
warp_2=`{
warp_3=`float2 d = (uv - 0.5) * aspect.xy;
warp_4=`float r = length(d);
warp_5=`float a = atan2(d.y, d.x);
warp_6=`float pull = q9 / (r * r + 0.005);
warp_7=`float sw = q10 * exp(-r * 4.0);
warp_8=`a += sw + q1 * 0.5;
warp_9=`r -= pull * 0.003;
warp_10=`float2 uv2 = float2(cos(a), sin(a)) * r * aspect.zw + 0.5;
warp_11=`ret = tex2D(sampler_main, uv2).xyz;
warp_12=`ret *= 0.96;
warp_13=`}
comp_1=`shader_body
comp_2=`{
comp_3=`float2 d = (uv - 0.5) * aspect.xy;
comp_4=`float r = length(d);
comp_5=`float a = atan2(d.y, d.x);
comp_6=`float3 col = tex2D(sampler_main, uv).xyz;
comp_7=`float disk = smoothstep(q7, q7 + 0.04, r) * smoothstep(q8, q8 - 0.08, r);
comp_8=`float hot = smoothstep(q6, q6 + 0.03, r) * smoothstep(q7, q7 - 0.03, r);
comp_9=`float diskPhase = a + q1 * 2.0 + q11;
comp_10=`float doppler = sin(diskPhase) * 0.5 + 0.5;
comp_11=`float3 acc = lerp(float3(0.9, 0.25, 0.02), float3(0.05, 0.25, 0.8), doppler);
comp_12=`col += acc * disk * q12;
comp_13=`col += float3(1.0, 0.85, 0.5) * hot * q12 * 1.5;
comp_14=`float flare = q5 * q5 * 0.4 * exp(-r * 3.0);
comp_15=`col += float3(0.8, 0.5, 0.2) * flare;
comp_16=`float shadow = smoothstep(q6 + 0.02, q6 - 0.01, r);
comp_17=`col *= 1.0 - shadow * 0.9;
comp_18=`float vig = smoothstep(0.8, 0.2, r);
comp_19=`col *= 0.3 + 0.7 * vig;
comp_20=`ret = saturate(col);
comp_21=`}
