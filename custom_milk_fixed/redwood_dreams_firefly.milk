// Signature Series | redwood_dreams | Redwood
// tags: nature, firefly, twinkle, light
// author: projectM-signature-batch-2026-07b
// project: redwood
// music: summer evening, acoustic, minimal percussion
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Redwood Dreams Firefly
fRating=4.000000
fGammaAdj=1.350000
fDecay=0.976000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nWaveMode=0
bAdditiveWaves=0
fWaveAlpha=0.001000
fWarpScale=1.220000
zoom=1.000000
rot=0.000000
warp=0.008000
cx=0.500000
cy=0.500000
mv_a=0.000000

per_frame_1=q1=time*0.25
per_frame_2=q2=bass_att
per_frame_3=q3=mid
per_frame_4=q4=treb_att
per_frame_5=q5=0.5+0.5*sin(time*0.4)
per_frame_6=q6=1.0
per_frame_7=q7=0.04
per_frame_8=q8=mid_att
per_frame_9=q9=time*0.6
per_frame_10=q10=0.06+q4*0.08
per_frame_11=q11=1.0
per_frame_12=q12=time

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.008;

warp_1=`shader_body
warp_2=`{
warp_3=`float2 uvc=uv-0.5;
warp_4=`uvc.y-=q7*sin(q1*0.3);
warp_5=`float2 nuv=uvc*0.985+0.5;
warp_6=`float3 col=tex2D(sampler_main,nuv).xyz;
warp_7=`float3 forest=float3(0.08,0.35+q8*0.15,0.12);
warp_8=`ret=lerp(col,forest,0.1);
warp_9=`}

comp_1=`shader_body
comp_2=`{
comp_3=`float3 col=tex2D(sampler_main,uv).xyz;
comp_4=`float2 p=uv*18.0+float2(q9*0.1,0.0);
comp_5=`float n=frac(sin(dot(floor(p),float2(127.1,311.7)))*43758.5453);
comp_6=`float2 f=frac(p);
comp_7=`float spark=step(0.97,n)*pow(1.0-length(f-0.5),3.0);
comp_8=`spark*=0.5+0.5*sin(q12*3.0+n*20.0);
comp_9=`spark*=q4*q10*2.0;
comp_10=`col+=float3(0.9,1.0,0.4)*spark;
comp_11=`col*=float3(0.8,0.95,0.85);
comp_12=`ret=saturate(col);
comp_13=`}
