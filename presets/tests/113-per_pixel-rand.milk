[preset00]
// rand() draws from the context's stream in the order the vertices run.
fDecay=0.980000
fWarpScale=2.853000
fZoomExponent=1.000000
warp=0.000000
sx=1.000000
sy=1.000000
ob_size=0.2
ob_r=0.0
ob_g=0.0
ob_b=0.0
ob_a=0.0
ib_size=0.01
ib_r=1.0
ib_g=0.0
ib_b=0.0
ib_a=1.0

per_frame_1=ib_r=0.7+0.4*sin(3*time);
per_frame_2=ib_g=0.7+0.4*sin(4*time);
per_frame_3=ib_b=0.7+0.4*sin(5*time);

per_pixel_1=zoom = 0.97 + rand(100)*0.0004;
per_pixel_2=rot = (rand(100) - 50)*0.001;
