[preset00]
// t carries from one vertex to the next (an IIR filter over the mesh): the result depends on
// the order the vertices run in, so the CPU loop must run them in order on one thread.
fDecay=0.980000
fWarpScale=2.853000
fZoomExponent=1.000000
warp=0.000000
sx=1.000000
sy=1.000000
ob_size=0.2
ob_r=0.0
ob_g=0.0
ob_b=0.0
ob_a=0.0
ib_size=0.01
ib_r=1.0
ib_g=0.0
ib_b=0.0
ib_a=1.0

per_frame_1=ib_r=0.7+0.4*sin(3*time);
per_frame_2=ib_g=0.7+0.4*sin(4*time);
per_frame_3=ib_b=0.7+0.4*sin(5*time);

per_pixel_1=t = t*0.9 + rad*0.1;
per_pixel_2=zoom = 0.96 + (t - rad)*0.4;
per_pixel_3=rot = (t - rad)*2;
