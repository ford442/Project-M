[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=3
fDecay=0.9
// A texture file that exists (with a wrap/filter prefix), one that does not (placeholder),
// preloaded 2D noise, a preloaded volume texture, and blur levels from sampler names and GetBlur.
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = tex2D(sampler_fw_main, uv).xyz;
warp_4=`  ret += tex2D(sampler_fw_pmtex, uv).xyz * texsize_pmtex.x * 0.01;
warp_5=`  ret += tex2D(sampler_pc_missingtexture, uv).xyz * 0.1;
warp_6=`  ret += tex2D(sampler_blur2, uv).xyz * 0.1;
warp_7=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  ret = tex2D(sampler_main, uv).xyz;
comp_4=`  ret += tex2D(sampler_noise_lq, uv).xyz * 0.1;
comp_5=`  ret += tex3D(sampler_noisevol_hq, float3(uv, time * 0.1)).xyz * 0.1;
comp_6=`  ret += GetBlur3(uv) * 0.1;
comp_7=`}
