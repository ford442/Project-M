// Signature Series | shader_swarm | Candy World
// tags: galaxy, swarm, spiral, medium
// author: projectM-signature-batch-2026-07b
// project: candy-world
// music: space ambient, downtempo electronic
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Shader Swarm Galaxy
fRating=4.500000
fGammaAdj=1.550000
fDecay=0.965000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nWaveMode=0
bAdditiveWaves=0
fWaveAlpha=0.001000
fWarpScale=1.331000
zoom=1.000000
rot=0.000000
warp=0.010000
cx=0.500000
cy=0.500000
mv_a=0.000000

per_frame_1=q1=time
per_frame_2=q2=bass_att
per_frame_3=q3=mid_att
per_frame_4=q4=treb_att
per_frame_5=q5=0.5+0.5*sin(time*0.5)
per_frame_6=q6=6.0
per_frame_7=q7=0.12+q2*0.1
per_frame_8=q8=mid_att
per_frame_9=q9=sin(time*0.7)
per_frame_10=q10=0.14+q3*0.08
per_frame_11=q11=1.0+q2*0.2
per_frame_12=q12=time*0.5

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`float2 uvc=uv-0.5;
warp_4=`float r=length(uvc);
warp_5=`float a=atan2(uvc.y,uvc.x)+q1*q7+r*q6;
warp_6=`float2 base=float2(cos(a)*r,sin(a)*r);
warp_7=`float3 acc=float3(0,0,0);
warp_8=`float2 p0=base*0.0+0.5; acc+=tex2D(sampler_main,p0).xyz;
warp_9=`float2 p1=base*0.12*q10+0.5; acc+=tex2D(sampler_main,p1).xyz*0.85;
warp_10=`float2 p2=base*0.24*q10+0.5; acc+=tex2D(sampler_main,p2).xyz*0.7;
warp_11=`float2 p3=base*0.36*q10+0.5; acc+=tex2D(sampler_main,p3).xyz*0.55;
warp_12=`float3 tint=float3(0.3+q8*0.4,0.2+q3*0.3,0.8+q2*0.4);
warp_13=`ret=acc*0.25*tint*q11;
warp_14=`}

comp_1=`shader_body
comp_2=`{
comp_3=`float3 col=tex2D(sampler_main,uv).xyz;
comp_4=`float2 c=uv-0.5;
comp_5=`float core=exp(-length(c)*4.0);
comp_6=`col+=float3(0.6,0.7,1.0)*core*0.2;
comp_7=`float dust=pow(max(col.r,max(col.g,col.b)),1.5)*q4;
comp_8=`col+=float3(0.5,0.6,1.0)*dust*0.25;
comp_9=`ret=saturate(col);
comp_10=`}
