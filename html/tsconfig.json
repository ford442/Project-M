{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "generated/**/*.ts",
    "projectm-host-types.ts",
    "projectm-wasm-api-worker.ts",
    "projectm-context-types.ts",
    "projectm-context.js",
    "projectm-context-loss.js",
    "projectm-element.js",
    "projectm-element-attributes.js",
    "projectm-init.js",
    "projectm-init-errors.js",
    "projectm-external-pcm.js",
    "projectm-audio-source-router.js",
    "projectm-presets.js",
    "projectm-audio-bootstrap.js",
    "projectm-fps-governor.js",
    "projectm-mesh-quality.js",
    "projectm-wasm-version.js",
    "projectm-fbo-format.js",
    "projectm-synthetic-audio.js",
    "projectm-preset-favorites.js",
    "projectm-transitions.js",
    "projectm-perf.js",
    "projectm-shader-cache.js",
    "projectm-preset-cache.js",
    "projectm-preset-library.js",
    "projectm-preset-picker.js",
    "projectm-preset-dev.js",
    "projectm-preset-tweaker.js",
    "projectm-render-worker-host.js"
  ]
}
