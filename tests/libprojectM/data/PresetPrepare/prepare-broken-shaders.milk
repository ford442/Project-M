[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
fDecay=0.9
// The warp shader does not transpile (the preset then runs without one); the composite
// shader does not either (the preset then falls back to the default composite shader).
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = tex2D(sampler_main, uv).xyz +* ;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  ret = undefined_function_name(uv);
comp_4=`}
