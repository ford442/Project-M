{
  "name": "@projectm/web",
  "version": "0.1.0",
  "description": "Embeddable projectM web components and context API for music visualizers",
  "license": "LGPL-2.1-only",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck:wrappers": "tsc -p tsconfig.src.json",
    "playground": "node scripts/serve-playground.mjs"
  },
  "files": [
    "dist",
    "scripts/fetch-wasm.mjs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/staging/projectm-element.d.ts",
      "default": "./dist/projectm-web.js"
    },
    "./element": {
      "types": "./dist/types/staging/projectm-element.d.ts",
      "default": "./dist/projectm-web.js"
    },
    "./context": {
      "types": "./dist/types/staging/projectm-context.d.ts",
      "default": "./dist/context.js"
    },
    "./wasm-version": {
      "types": "./dist/types/staging/projectm-wasm-version.d.ts",
      "default": "./dist/wasm-version.js"
    },
    "./wasm-api": {
      "types": "./dist/types/staging/generated/projectm-wasm-api.d.ts",
      "default": "./dist/wasm-api.js"
    },
    "./react": {
      "types": "./dist/types/src/react.d.ts",
      "default": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/types/src/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./vue": {
      "types": "./dist/types/src/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./render-worker": {
      "default": "./dist/projectm-render-worker.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/staging/projectm-element.d.ts",
  "peerDependencies": {
    "react": ">=17"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ford442/Project-M.git",
    "directory": "packages/web"
  },
  "keywords": [
    "projectm",
    "milkdrop",
    "visualizer",
    "web-component",
    "wasm"
  ],
  "devDependencies": {
    "@types/react": "19.2.2",
    "esbuild": "0.28.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.8.3"
  },
  "bin": {
    "projectm-fetch-wasm": "./scripts/fetch-wasm.mjs"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
