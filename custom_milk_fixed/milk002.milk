// CHANGELOG 2026-06-19 — WASM upgrade
// - Ported bright segmented plasma from per_pixel HLSL → comp_ shader
// - Added MILKDROP_PRESET_VERSION=200 + PSVERSION_WARP/COMP=3
// Author: projectM AI | Bright Plasma Tiles
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Bright Plasma Tiles
fRating=3.0
fGammaAdj=2.0
fDecay=0.980
fVideoEchoZoom=1.0
fVideoEchoAlpha=0.0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.001
fWaveScale=1.002
fWaveSmoothing=0.261
fWaveParam=0.0
fModWaveAlphaStart=0.5
fModWaveAlphaEnd=1.0
fWarpAnimSpeed=1.0
fWarpScale=1.331
fZoomExponent=1.0
fShader=0.0
zoom=1.0
rot=0.0
cx=0.5
cy=0.5
dx=0.0
dy=0.0
warp=0.01
sx=1.0
sy=1.0
ob_size=0.01
ib_size=0.01
mv_a=0.0

per_frame_1=rot=rot+0.002;
per_frame_2=q1=1+30*(0.5+0.5*sin(time*0.15));
per_frame_3=q2=0.5+0.5*sin(time*0.4);
per_frame_4=q3=time*1.2+rot;
per_frame_5=q4=time*1.3+rot;
per_frame_6=q5=time*1.5+rot;
per_frame_7=q6=bass_att;

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz;
warp_4=`}

comp_1=`shader_body
comp_2=`{
comp_3=`    float segX = floor(uv.x * q1) / q1;
comp_4=`    float segY = floor(uv.y * q1) / q1;
comp_5=`    float workX = lerp(uv.x, segX, q2);
comp_6=`    float workY = lerp(uv.y, segY, q2);
comp_7=`    float r = 0.7 + 0.3 * sin(workX * 8.0 + q3);
comp_8=`    float g = 0.7 + 0.3 * sin(workY * 8.0 + q4);
comp_9=`    float b = 0.7 + 0.3 * sin((workX + workY) * 4.0 + q5);
comp_10=`    float boost = 1.2 + 0.8 * q6;
comp_11=`    ret = saturate(float3(min(r * boost, 1.0), min(g * boost, 1.0), min(b * boost, 1.0)));
comp_12=`}
