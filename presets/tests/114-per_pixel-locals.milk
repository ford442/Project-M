[preset00]
// Locals and q assigned before they are read: every vertex is independent, so the CPU loop
// may spread the vertices over threads and must still render what one thread renders.
fDecay=0.980000
fWarpScale=2.853000
fZoomExponent=1.000000
warp=0.000000
sx=1.000000
sy=1.000000
ob_size=0.2
ob_r=0.0
ob_g=0.0
ob_b=0.0
ob_a=0.0
ib_size=0.01
ib_r=1.0
ib_g=0.0
ib_b=0.0
ib_a=1.0

per_frame_1=ib_r=0.7+0.4*sin(3*time);
per_frame_2=ib_g=0.7+0.4*sin(4*time);
per_frame_3=ib_b=0.7+0.4*sin(5*time);
per_frame_4=q1=sin(time);

per_pixel_1=d = rad*rad;
per_pixel_2=q2 = sin(ang*3 + time);
per_pixel_3=zoom = 0.96 + d*0.05 + q2*0.01;
per_pixel_4=rot = q1*0.02 + d*0.1;
