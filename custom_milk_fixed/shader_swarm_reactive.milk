// Signature Series | shader_swarm | Candy World
// tags: reactive, swarm, disco, medium
// author: projectM-signature-batch-2026-07
// project: candy-world
// music: funk, disco edits, sharp hats
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Shader Swarm Reactive
fRating=4.500000
fGammaAdj=1.700000
fDecay=0.960000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nWaveMode=0
bAdditiveWaves=0
fWaveAlpha=0.001000
fWarpScale=1.331000
zoom=1.000000
rot=0.000000
warp=0.010000
cx=0.500000
cy=0.500000
mv_a=0.000000

per_frame_1=q1=time*1.1
per_frame_2=q2=bass_att
per_frame_3=q3=mid_att
per_frame_4=q4=treb_att
per_frame_5=q5=0.5+0.5*sin(time*1.3)
per_frame_6=q6=6.0
per_frame_7=q7=0.11+q2*0.06
per_frame_8=q8=mid_att
per_frame_9=q9=sin(time*3.0)
per_frame_10=q10=0.1+q4*0.12
per_frame_11=q11=1.0+q2*0.25
per_frame_12=q12=time

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`float2 uvc=uv-0.5;
warp_4=`float pull=1.0-q2*0.25;
warp_5=`uvc*=pull;
warp_6=`float a=atan2(uvc.y,uvc.x)+q1*q7;
warp_7=`float r=length(uvc);
warp_8=`float2 p=float2(cos(a+q5)*r,sin(a+q5)*r);
warp_9=`float3 c0=tex2D(sampler_main,p+0.5).xyz;
warp_10=`float3 c1=tex2D(sampler_main,p*q10+0.5).xyz;
warp_11=`float3 c2=tex2D(sampler_main,-p*0.5+0.5).xyz;
warp_12=`float3 hue=float3(0.5+0.5*sin(q12),0.5+0.5*sin(q12+2.1),0.5+0.5*sin(q12+4.2));
warp_13=`ret=(c0+c1*0.7+c2*0.5)*hue*q11;
warp_14=`}

comp_1=`shader_body
comp_2=`{
comp_3=`float3 col=tex2D(sampler_main,uv).xyz;
comp_4=`float flash=step(0.85,frac(q1*4.0+q4*2.0))*q4*0.15;
comp_5=`col+=flash;
comp_6=`ret=saturate(col);
comp_7=`}
