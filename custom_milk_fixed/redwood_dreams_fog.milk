// Signature Series | redwood_dreams | Redwood
// tags: nature, fog, mist, light
// author: projectM-signature-batch-2026-07
// project: redwood
// music: misty morning ambient
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Redwood Dreams Fog
fRating=4.000000
fGammaAdj=1.350000
fDecay=0.977000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nWaveMode=0
bAdditiveWaves=0
fWaveAlpha=0.001000
fWarpScale=1.200000
zoom=1.000000
rot=0.000000
warp=0.008000
cx=0.500000
cy=0.500000
mv_a=0.000000

per_frame_1=q1=time*0.12
per_frame_2=q2=bass_att
per_frame_3=q3=mid_att
per_frame_4=q4=treb_att
per_frame_5=q5=(bass+mid+treb)*0.1
per_frame_6=q6=1.0
per_frame_7=q7=0.04
per_frame_8=q8=mid_att
per_frame_9=q9=time*0.02
per_frame_10=q10=0.07
per_frame_11=q11=1.0
per_frame_12=q12=time

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.008;

warp_1=`shader_body
warp_2=`{
warp_3=`float2 uvc=uv-0.5;
warp_4=`float r=length(uvc);
warp_5=`float a=atan2(uvc.y,uvc.x)+q7;
warp_6=`float2 nuv=float2(cos(a)*r*0.99,sin(a)*r*0.99)+0.5;
warp_7=`float3 col=tex2D(sampler_main,nuv).xyz;
warp_8=`float3 echo=tex2D(sampler_main,uv+float2(q9*0.01,0.0)).xyz;
warp_9=`ret=lerp(col,echo,0.25);
warp_10=`}

comp_1=`shader_body
comp_2=`{
comp_3=`float3 col=tex2D(sampler_main,uv).xyz;
comp_4=`float fog=smoothstep(0.2,0.9,length(uv-0.5));
comp_5=`fog*=0.35+q5*0.4;
comp_6=`float3 mist=float3(0.75,0.82,0.72);
comp_7=`col=lerp(col,mist,fog);
comp_8=`col*=float3(0.9,1.0,0.85);
comp_9=`ret=saturate(col);
comp_10=`}
