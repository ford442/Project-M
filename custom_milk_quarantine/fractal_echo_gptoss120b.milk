// CHANGELOG 2026-06-19 — WASM upgrade
// - Added shader_body wrappers; fixed wave/shape key prefixes
// - Replaced clamp() and undefined hue_shader reference
// Author: projectM AI | Fractal Echo GPT
[preset00]
presetname=Fractal Echo GPT
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
fDecay=0.970
fGammaAdj=2.2
bBrighten=1
bDarken=0
bInvert=0
bSolarize=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
fWaveAlpha=0.0
fShader=0.0
zoom=0.95
rot=0.0
cx=0.5
cy=0.5
dx=0.0
dy=0.0
warp=0.5
sx=1.0
sy=1.0
ob_size=0.01
ib_size=0.01
mv_a=0.0

per_frame_init_1=BASE_ZOOM=0.95;
per_frame_init_2=BASE_WARP=0.5;
per_frame_init_3=BASS_SENS=0.08;
per_frame_init_4=MID_SPEED=0.02;
per_frame_init_5=TREB_SENS=0.25;

per_frame_1=q1=min(max(bass,0),1)*BASS_SENS;
per_frame_2=q2=min(max(mid,0),1)*MID_SPEED;
per_frame_3=q3=min(max(treb,0),1)*TREB_SENS;
per_frame_4=zoom=BASE_ZOOM+q1;
per_frame_5=rot=rot+q2;
per_frame_6=warp=BASE_WARP+q3;
per_frame_7=q4=warp;
per_frame_8=q7=mid_att;
per_frame_9=q8=treb_att;

per_pixel_1=zoom=zoom*(1.0-rad*0.15);
per_pixel_2=rot=rot+rad*0.5;

wavecode_0_enabled=1
wavecode_0_bSpectrum=1
wavecode_0_samples=128
wavecode_0_scaling=0.55
wavecode_0_smoothing=0.6
wavecode_0_bAdditive=1
wavecode_0_r=0.9
wavecode_0_g=0.6
wavecode_0_b=0.3
wavecode_0_a=0.8

wave_0_init1=t1=0;

wave_0_per_frame1=t1=t1+0.015;

wave_0_per_point1=ang=sample*2.0*3.14159265+t1;
wave_0_per_point2=rad=0.25+0.15*value1;
wave_0_per_point3=x=0.5+rad*cos(ang);
wave_0_per_point4=y=0.5+rad*sin(ang);
wave_0_per_point5=r=0.8+0.2*sin(ang+time);
wave_0_per_point6=g=0.5+0.5*value1;
wave_0_per_point7=b=0.9-0.3*value1;

shapecode_0_enabled=1
shapecode_0_sides=5
shapecode_0_num_inst=3
shapecode_0_rad=0.12
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_r=0.4
shapecode_0_g=0.6
shapecode_0_b=1.0
shapecode_0_a=0.7
shapecode_0_border_r=1.0
shapecode_0_border_g=1.0
shapecode_0_border_b=1.0
shapecode_0_border_a=0.5
shapecode_0_additive=1

shape_0_per_frame1=t1=time*0.3;
shape_0_per_frame2=inst_off=instance*2.0*3.14159265/3.0;
shape_0_per_frame3=ang=t1+inst_off;
shape_0_per_frame4=x=0.5+0.25*cos(ang);
shape_0_per_frame5=y=0.5+0.25*sin(ang);
shape_0_per_frame6=rad=0.12+0.04*sin(time+instance);
shape_0_per_frame7=r=0.4+0.3*sin(time+instance);
shape_0_per_frame8=g=0.5+0.2*cos(time+instance);
shape_0_per_frame9=b=0.8+0.1*sin(time*2.0+instance);

warp_1=`shader_body
warp_2=`{
warp_3=`    float2 c = uv - 0.5;
warp_4=`    float r = length(c);
warp_5=`    float a = atan2(c.y, c.x);
warp_6=`    float sectors = 6.0;
warp_7=`    a = fmod(a, 2.0 * 3.14159265 / sectors);
warp_8=`    a = abs(a);
warp_9=`    a += time * 0.2;
warp_10=`    float radial = r + 0.12 * sin(r * 12.0 + time) * q1;
warp_11=`    float2 new_uv = 0.5 + radial * float2(cos(a), sin(a));
warp_12=`    float2 out_uv = lerp(uv_orig, new_uv, q4);
warp_13=`    ret = tex2D(sampler_main, out_uv).xyz;
warp_14=`}

comp_1=`shader_body
comp_2=`{
comp_3=`    float glow = saturate(q7 * 0.6 + q8 * 0.4);
comp_4=`    float3 base = tex2D(sampler_main, uv).xyz;
comp_5=`    float3 glowCol = float3(1.0, 0.8, 0.6) * glow;
comp_6=`    float3 outCol = base + glowCol;
comp_7=`    outCol = outCol * 1.2;
comp_8=`    ret = saturate(outCol);
comp_9=`}
