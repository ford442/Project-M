// CHANGELOG 2026-06-19 — WASM upgrade
// - Ported segmented plasma from per_pixel HLSL → comp_ shader (projectM WASM path)
// - Added MILKDROP_PRESET_VERSION=200 + PSVERSION_WARP/COMP=3
// Author: projectM AI | Plasma Mosaic
MILKDROP_PRESET_VERSION=200
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
presetname=Plasma Mosaic
fRating=4.0
fGammaAdj=2.0
fDecay=0.980
fVideoEchoZoom=1.0
fVideoEchoAlpha=0.0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.001
fWaveScale=1.002
fWaveSmoothing=0.261
fWaveParam=0.0
fModWaveAlphaStart=0.5
fModWaveAlphaEnd=1.0
fWarpAnimSpeed=1.0
fWarpScale=1.331
fZoomExponent=1.0
fShader=0.0
zoom=1.0
rot=0.0
cx=0.5
cy=0.5
dx=0.0
dy=0.0
warp=0.01
sx=1.0
sy=1.0
ob_size=0.01
ib_size=0.01
mv_a=0.0

per_frame_1=rot=rot+0.002;
per_frame_2=q1=1+30*(0.5+0.5*sin(time*0.15));
per_frame_3=q2=0.5+0.5*sin(time*0.4);
per_frame_4=q3=time*0.8+rot;
per_frame_5=q4=time*0.9+rot;
per_frame_6=q5=time+rot;
per_frame_7=q6=time*0.4;
per_frame_8=q7=bass_att;

per_pixel_1=zoom=1.0;
per_pixel_2=rot=0.0;
per_pixel_3=warp=0.01;

warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz;
warp_4=`}

comp_1=`shader_body
comp_2=`{
comp_3=`    float segX = floor(uv.x * q1) / q1;
comp_4=`    float segY = floor(uv.y * q1) / q1;
comp_5=`    float workX = lerp(uv.x, segX, q2);
comp_6=`    float workY = lerp(uv.y, segY, q2);
comp_7=`    float bgR = 0.5 + 0.5 * sin(workX * 4.0 + q3);
comp_8=`    float bgG = 0.5 + 0.5 * sin(workY * 4.0 + q4);
comp_9=`    float bgB = 0.5 + 0.5 * sin((workX + workY) * 2.0 + q5);
comp_10=`    float sharpX = 1.0 - abs(sin(fmod(workX * 25.0 + q6, 6.283)));
comp_11=`    float sharpY = 1.0 - abs(cos(fmod(workY * 25.0 - q6, 6.283)));
comp_12=`    float sharpPattern = pow(sharpX * sharpY, 3.0);
comp_13=`    float baseR = bgR * 0.7 + bgG * 0.3;
comp_14=`    float baseG = bgG * 0.7 + bgB * 0.3;
comp_15=`    float baseB = bgB * 0.7 + bgR * 0.3;
comp_16=`    float boost = 2.2 + 0.8 * q7;
comp_17=`    float3 col = float3(
comp_18=`        min(baseR + sharpPattern * 1.8, 1.0),
comp_19=`        min(baseG + sharpPattern * 1.6, 1.0),
comp_20=`        min(baseB + sharpPattern * 2.0, 1.0));
comp_21=`    col *= boost;
comp_22=`    ret = saturate(col);
comp_23=`}
