// Preset with a warp shader containing syntactically invalid HLSL.
// Used to verify that PresetCompatTest's harness reports HLSL parsing failures.
warp_1=`shader_body
warp_2=`{
warp_3=`ret = tex2D(sampler_main, uv float garbage !!! ;
warp_4=`}

comp_1=`shader_body
comp_2=`{
comp_3=`ret = tex2D(sampler_main, uv).xyz;
comp_4=`}
