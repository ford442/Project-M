{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "generated/**/*.ts",
    "projectm-wasm-api-worker.ts",
    "projectm-context.ts",
    "projectm-element.ts"
  ]
}
